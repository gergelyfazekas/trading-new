venv/
__pycache__/
*.pyc
.DS_Store
# Bulk data (price tiers, grid-search logs) is regenerable -- keep it out.
# The two exceptions below are not: live_log.csv is a decision-time forward
# record that can never be recomputed (see append_log in tech_level_live.py),
# and live_combos.json defines what its rows mean. Both are tiny.
data/*
!data/live_log.csv
!data/live_combos.json

# Same convention for the five_day_bounce strategy's own data folder:
# fixed_combo.json is the frozen live combo (tiny, defines what the CSVs
# below mean); the trade/signal/position files are regenerable or append-only
# forward records kept out of git for the same reason as data/live_log.csv.
strategies/five_day_bounce/data/*
!strategies/five_day_bounce/data/fixed_combo.json
